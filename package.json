{
  "name": "clinical-biometrics-mastery-os",
  "private": true,
  "version": "0.1.0",
  "description": "An interactive, industry-oriented training environment for clinical statistical programming, biostatistics, CDISC, and applied pharma analytics. Educational use with synthetic data only.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "validate": "tsx scripts/validate-content.ts",
    "data": "tsx scripts/data/generate-all.ts",
    "check": "npm run typecheck && npm run validate && npm run test",
    "capstones": "tsx scripts/tools/gen-capstone-starters.ts",
    "readme": "tsx scripts/tools/update-readme-stats.ts"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
