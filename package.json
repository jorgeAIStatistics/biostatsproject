    "@types/node": "^26.6.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "@types/unist": "^3.0.3",
    "@vitejs/plugin-react": "^6.1.1",
    "remark-parse": "^11.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "unified": "^11.0.5",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
